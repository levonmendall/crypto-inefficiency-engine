CIE_PAPER_ONLY=true
CIE_SCAN_INTERVAL_SECONDS=30
CIE_DEFAULT_HOLDING_HOURS=24
CIE_MIN_NET_ANNUALIZED_RETURN=0.08
CIE_SAFETY_BUFFER_BPS_PER_HOUR=0.02
CIE_PAIR_ROUNDTRIP_COST_BPS=20
CIE_MAX_QUOTE_AGE_SECONDS=120
CIE_MAX_ORDER_BOOK_AGE_SECONDS=15
CIE_MAX_ORDER_BOOK_SKEW_SECONDS=5
CIE_EXIT_SLIPPAGE_MULTIPLIER=1
CIE_CAPACITY_SEARCH_TOLERANCE_USD=1
CIE_CAPITAL_TIERS_USD=1000,10000,25000,50000,100000
CIE_EVIDENCE_DB_PATH=data/cie-evidence.sqlite3

# Conservative public-tier execution assumptions; override only with verified account-tier data.
CIE_COINBASE_SPOT_TAKER_FEE_BPS=60
CIE_HYPERLIQUID_PERP_TAKER_FEE_BPS=4.5
CIE_SPOT_COLLATERAL_FRACTION=1
CIE_PERP_COLLATERAL_FRACTION=1
CIE_COLLATERAL_OPPORTUNITY_COST_ANNUAL=0.04
# CIE_SPOT_SHORT_BORROW_ANNUAL=0.10
CIE_EXPECTED_HEDGE_LATENCY_MS=750
CIE_LATENCY_RISK_BPS_PER_SECOND=0.5
CIE_HEDGE_LIQUIDITY_RESERVE_RATIO=1.25
CIE_HEDGE_RECOVERY_BUFFER_BPS=2

# v0.7 multi-horizon shadow attribution.
CIE_SHADOW_HORIZONS_SECONDS=1,5,15,30,60
CIE_SHADOW_NOTIONAL_USD=1000
# 0 means follow every qualified opportunity/capital-tier cohort.
CIE_SHADOW_MAX_CANDIDATES=0
CIE_SHADOW_SLIPPAGE_EXPANSION_BPS=1
CIE_SHADOW_HEDGE_DIVERGENCE_BPS=5
CIE_SHADOW_CYCLE_INTERVAL_SECONDS=30
# Legacy one-horizon override retained for callers that explicitly request it.
CIE_SHADOW_DELAY_SECONDS=5

# Production evidence storage. Render injects DATABASE_URL from managed Postgres.
# CIE_DATABASE_URL=postgresql://user:password@host:5432/cie_evidence
CIE_WORKER_ERROR_BACKOFF_SECONDS=15
CIE_WORKER_HEARTBEAT_STALE_SECONDS=180
